<?xml version="1.0"?>
<!--
  Detection-only launch.

  Subscribes to an arbitrary sensor_msgs/Image source (remap or override
  via `image_topic`). Use this when an image source already exists (a real
  camera, a rosbag, etc.). For the pooh sample videos, use video.launch
  which wraps this launch with video_stream_opencv.
-->
<launch>
  <arg name="image_topic" default="image"
       doc="Input sensor_msgs/Image topic (remapped onto the node's 'image')."/>
  <arg name="model" default="yolov8x-worldv2.pt"/>
  <arg name="device" default="cuda"/>
  <arg name="balloon_classes" default="balloon,red balloon"
       doc="Comma-separated YOLO-World prompts treated as the balloon class."/>
  <arg name="teddy_classes" default="teddy bear,stuffed animal,Winnie the Pooh plush"
       doc="Comma-separated YOLO-World prompts treated as the receiver class."/>
  <arg name="visualize" default="false"
       doc="Open image_view on the annotated output topic."/>
  <arg name="use_uv" default="false"
       doc="Launch via the uv-managed virtualenv wrapper (requires building with -DUSE_UV=ON)."/>
  <arg name="compressed" default="false"
       doc="Subscribe to sensor_msgs/CompressedImage instead of raw Image (remap 'image' accordingly)."/>

  <!-- catkin_virtualenv (default) path. -->
  <node name="detect_events" pkg="balloon_detection" type="detect_events_node.py"
        output="screen" required="true" unless="$(arg use_uv)">
    <remap from="image" to="$(arg image_topic)"/>
    <param name="model" value="$(arg model)"/>
    <param name="device" value="$(arg device)"/>
    <param name="use_header_stamp" value="true"/>
    <param name="balloon_classes" value="$(arg balloon_classes)"/>
    <param name="teddy_classes" value="$(arg teddy_classes)"/>
    <param name="compressed" value="$(arg compressed)"/>
  </node>

  <!-- uv-managed path: uses the wrapper generated by CMake (USE_UV=ON). -->
  <node name="detect_events" pkg="balloon_detection" type="detect_events_node_uv"
        output="screen" required="true" if="$(arg use_uv)">
    <remap from="image" to="$(arg image_topic)"/>
    <param name="model" value="$(arg model)"/>
    <param name="device" value="$(arg device)"/>
    <param name="use_header_stamp" value="true"/>
    <param name="balloon_classes" value="$(arg balloon_classes)"/>
    <param name="teddy_classes" value="$(arg teddy_classes)"/>
    <param name="compressed" value="$(arg compressed)"/>
  </node>

  <node name="annotated_view" pkg="image_view" type="image_view" output="screen"
        if="$(arg visualize)">
    <remap from="image" to="/detect_events/image_annotated"/>
  </node>
</launch>
