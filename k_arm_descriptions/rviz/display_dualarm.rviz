Panels:
  - Class: rviz/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
    - Class: rviz/RobotModel
      Name: K_ARM
      Enabled: true
      Robot Description: robot_description
    - Class: rviz/TF
      Name: TF
      Enabled: false
  Global Options:
    Fixed Frame: ARM_BODY
  Name: root
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 2.0
      Focal Point: {X: 0, Y: 0, Z: -0.3}
      Pitch: 0.3
      Yaw: 0.8
Window Geometry:
  Height: 900
  Width: 1400
