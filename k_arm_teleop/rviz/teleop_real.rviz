Panels:
  - Class: rviz/Displays
    Name: Displays
    Splitter Ratio: 0.5
  - Class: k_arm_teleop/TeleopPanel
    Name: K_ARM Teleop
    manager: /k_arm_teleop_manager
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Reference Frame: <Fixed Frame>
    - Class: rviz/RobotModel
      Name: K_ARM (real)
      Enabled: true
      Robot Description: /k_arm_teleop/robot_description
      Alpha: 1
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz/RobotModel
      Name: K_ARM (virtual)
      Enabled: true
      Robot Description: /virtual/display_description
      Alpha: 0.3
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz/RobotModel
      Name: Leader arm
      Enabled: true
      Robot Description: /teleop_leader/robot_description
      Alpha: 1
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz/RobotModel
      Name: Calibration guide
      Enabled: true
      Robot Description: /teleop_leader_guide/robot_description
      Alpha: 0.25
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz/Marker
      Name: Calibration guide label
      Enabled: true
      Marker Topic: /teleop_leader_guide/label
    - Class: rviz/Image
      Name: Wrist camera
      Enabled: true
      Image Topic: /wrist_right_camera/color/image_raw
      Transport Hint: compressed
      Queue Size: 2
      Max Value: 1
      Median window: 5
      Min Value: 0
      Normalize Range: true
    - Class: rviz/Image
      Name: Head camera
      Enabled: true
      Image Topic: /head_camera/color/image_raw
      Transport Hint: compressed
      Queue Size: 2
      Max Value: 1
      Median window: 5
      Min Value: 0
      Normalize Range: true
    # the picking policy's detections (k_arm_pick_policy, kpick_policy_node ~debug/image)
    - Class: rviz/Image
      Name: Policy detections
      Enabled: true
      Image Topic: /kpick_policy/debug/image
      Transport Hint: compressed
      Queue Size: 2
      Max Value: 1
      Median window: 5
      Min Value: 0
      Normalize Range: true
    # step mode: the steps ~step runs next (thick; red where the gripper closes) and the ones after
    - Class: rviz/MarkerArray
      Name: Policy prediction
      Enabled: true
      Marker Topic: /kpick_policy/predicted/markers
      Queue Size: 10
      Namespaces: {}
    - Class: rviz/Path
      Name: Policy predicted path
      Enabled: false
      Topic: /kpick_policy/predicted/path
      Color: 25; 255; 0
      Alpha: 1
      Line Style: Lines
      Line Width: 0.03
      Buffer Length: 1
      Pose Style: None
      Queue Size: 10
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: ARM_BODY
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 3.0
      Focal Point: {X: 0, Y: 0.6, Z: -0.3}
      Pitch: 0.35
      Yaw: 0.0
      Name: Current View
      Target Frame: <Fixed Frame>
Window Geometry:
  Wrist camera:
    collapsed: false
  Head camera:
    collapsed: false
  Policy detections:
    collapsed: false
  Displays:
    collapsed: false
  K_ARM Teleop:
    collapsed: false
  Height: 1000
  # the teleop panel docked on the right, Displays (and cameras) on the left
  QMainWindow State: 
  Width: 1600
