<launch>

  <arg name="queue_size" value="30" />

  <arg name="bagfile" doc="Input bagfile path"/>

  <param name="/use_sim_time" value="true"/>

  <node name="rosbag_play" pkg="rosbag" type="play"
        args="$(arg bagfile) --clock --loop"/>

  <include file="$(find manip_teaching)/launch/republish_images.launch" >
    <arg name="queue_size" value="$(arg queue_size)" />
  </include>

</launch>
