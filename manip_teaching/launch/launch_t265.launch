<launch>

  <arg name="camera" default="t265" />
  <arg name="enable_fisheye1" default="false" />
  <arg name="enable_fisheye1" default="false" />

  <include file="$(find manip_teaching)/launch/rs_t265.launch" >
    <arg name="camera" value="$(arg camera)" />
    <arg name="enable_fisheye1" value="$(arg enable_fisheye1)" />
    <arg name="enable_fisheye2" value="$(arg enable_fisheye2)" />
  </include>

  <group ns="$(arg camera)" >
    <group ns="fisheye1" >
      <group ns="image_raw" >
        <rosparam param="disable_pub_plugins">
          - 'image_transport/compressedDepth'
          - 'image_transport/theora'
        </rosparam>
      </group>
    </group>  <!-- end of fisheye1 ns -->
    <group ns="fisheye2" >
      <group ns="image_raw" >
        <rosparam param="disable_pub_plugins">
          - 'image_transport/compressedDepth'
          - 'image_transport/theora'
        </rosparam>
      </group>
    </group>  <!-- end of fisheye2 ns -->
  </group>

  <group ns="$(arg camera)" >
    <group if="$(arg enable_fisheye1)" ns="fisheye1" >
      <node name="rectify_image"
            pkg="nodelet" type="nodelet"
            respawn="true"
            args="load image_proc/rectify /t265/realsense2_camera_manager" >
        <remap from="image_mono" to="image_raw" />
      </node>
    </group> <!-- end of fisheye1 ns -->

    <group if="$(arg enable_fisheye2)" ns="fisheye2" >
      <node name="rectify_image"
            pkg="nodelet" type="nodelet"
            respawn="true"
            args="load image_proc/rectify /t265/realsense2_camera_manager" >
        <remap from="image_mono" to="image_raw" />
      </node>
    </group> <!-- end of fisheye2 ns -->

  </group> <!-- end of camera ns -->

</launch>
