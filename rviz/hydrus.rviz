Panels:
  - Class: rviz/Displays
    Name: Displays
Visualization Manager:
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: world
    Frame Rate: 30
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.5
      Plane Cell Count: 20
      Color: 160; 160; 160
    - Class: rviz/RobotModel
      Name: RobotModel
      Enabled: true
      Robot Description: robot_description
      TF Prefix: hydrus
      Visual Enabled: true
      Collision Enabled: false
      Update Interval: 0
    - Class: rviz/TF
      Name: TF
      Enabled: true
      Show Names: true
      Show Axes: true
      Show Arrows: false
      Marker Scale: 0.3
      Frames:
        All Enabled: false
        hydrus/root:
          Value: true
        hydrus/leg5:
          Value: true
        hydrus/fc:
          Value: true
        hydrus/cog:
          Value: true
  Tools:
    - Class: rviz/MoveCamera
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
  Views:
    Current:
      Class: rviz/Orbit
      Name: Current View
      Distance: 4.0
      Focal Point:
        X: 0.0
        Y: 0.0
        Z: 1.0
      Pitch: 0.6
      Yaw: 0.8
Window Geometry:
  Height: 800
  Width: 1200
