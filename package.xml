<?xml version="1.0"?>
<package format="2">
  <name>balloon_detection</name>
  <version>0.1.0</version>
  <description>
    Open-vocabulary object detection with YOLO-WorldV2. Subscribes to
    sensor_msgs/Image (e.g. from video_stream_opencv), detects the text
    prompts given in ~classes, and publishes the boxes and class names of
    every frame.
  </description>

  <maintainer email="ab.ioryz@gmail.com">iory</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>catkin_virtualenv</depend>

  <exec_depend>rospy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>jsk_recognition_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>message_filters</exec_depend>
  <exec_depend>image_transport</exec_depend>
  <exec_depend>video_stream_opencv</exec_depend>
  <exec_depend>image_view</exec_depend>

  <export>
    <pip_requirements>requirements.txt</pip_requirements>
  </export>
</package>
