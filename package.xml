<?xml version="1.0"?>
<package format="2">
  <name>balloon_detection</name>
  <version>0.1.0</version>
  <description>
    Balloon hand-off / fly-away event detection using YOLO-WorldV2 + ByteTrack.
    Subscribes to sensor_msgs/Image (e.g. from video_stream_opencv) and runs a
    per-frame state machine that emits RECEIVED / FLEW_AWAY events.
  </description>

  <maintainer email="ab.ioryz@gmail.com">iory</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>catkin_virtualenv</depend>

  <exec_depend>rospy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>image_transport</exec_depend>
  <exec_depend>video_stream_opencv</exec_depend>
  <exec_depend>image_view</exec_depend>

  <export>
    <pip_requirements>requirements.txt</pip_requirements>
  </export>
</package>
